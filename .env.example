# Same deployment managed by kenchogroup-admin.
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# Required: match the server-only value in that Convex deployment (32+ characters).
LEAD_INGEST_SECRET=

# AI provider. Legacy GEMNI_API_KEY spelling is also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required only for private project attachments.
IMAGE_KIT_SECRET_KEY=

# Production public origin, especially behind a TLS-terminating proxy.
# SITE_ORIGIN=https://www.kenchogroup.ge

# Only when your reverse proxy supplies/overwrites this header (e.g. ngrok).
# TRUSTED_IP_HEADER=x-forwarded-for
